# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; this file is committed.
# On Vercel, set these same keys under Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-50-char-random-string

# Never True in production.
DEBUG=True

# Comma-separated. Vercel's own hostname is added automatically at runtime.
ALLOWED_HOSTS=127.0.0.1,localhost

# Neon POOLED connection string -- host contains "-pooler". Used by the app.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon DIRECT connection string -- no "-pooler". Used only by migrate/makemigrations.
DATABASE_URL_DIRECT=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
